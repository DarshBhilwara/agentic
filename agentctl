def tool_execute_command(args: Dict, cwd: str) -> str:
    command = (args or {}).get("command", "")
    if not command:
        return "Error: no command provided."
    result = subprocess.run(command, shell=True, text=True, capture_output=True, cwd=cwd)
    output_str = f"STDOUT:\n{result.stdout}\n" if result.stdout else ""
    output_str += f"STDERR:\n{result.stderr}\n" if result.stderr else ""
    if not output_str:
        output_str = "Executed successfully with no stdout/stderr.\n"
    output_str += f"Exit code: {result.returncode}"
    return output_str


def tool_read_file(args: Dict, cwd: str) -> str:
    path = (args or {}).get("path", "")
    if not path:
        return "Error: no path provided."
    full_path = path if os.path.isabs(path) else os.path.join(cwd, path)
    try:
        with open(full_path, "r", errors="replace") as f:
            content = f.read()
        if len(content) > 20000:
            content = content[:20000] + "\n... (truncated)"
        return content if content else "(file is empty)"
    except Exception as e:
        return f"Error reading file: {e}"


def tool_write_file(args: Dict, cwd: str) -> str:
    path = (args or {}).get("path", "")
    content = (args or {}).get("content", "")
    if not path:
        return "Error: no path provided."
    full_path = path if os.path.isabs(path) else os.path.join(cwd, path)
    try:
        parent = os.path.dirname(full_path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(full_path, "w") as f:
            f.write(content)
        return f"Wrote {len(content)} bytes to {full_path}"
    except Exception as e:
        return f"Error writing file: {e}"


def tool_list_directory(args: Dict, cwd: str) -> str:
    path = (args or {}).get("path", ".") or "."
    full_path = path if os.path.isabs(path) else os.path.join(cwd, path)
    try:
        entries = sorted(os.listdir(full_path))
        return "\n".join(entries) if entries else "(empty directory)"
    except Exception as e:
        return f"Error listing directory: {e}"


def tool_web_search(args: Dict, cwd: str) -> str:
    query = (args or {}).get("query", "")
    max_results = (args or {}).get("max_results", 5)
    if not query:
        return "Error: no query provided."

    api_key = os.getenv("SERPER_API_KEY")
    if not api_key:
        return (
            "Error: web_search is not configured. Set SERPER_API_KEY environment variable "
        )

    try:
        headers = {
            "X-API-KEY": api_key,
            "Content-Type": "application/json"
        }
        res = requests.post(
            "https://google.serper.dev/search",
            headers=headers,
            json={"q": query, "num": max_results},
            timeout=15,
        )
        res.raise_for_status()
        data = res.json()
        organic = data.get("organic", [])
        if not organic:
            return "No search results found."

        lines = []
        for r in organic[:max_results]:
            snippet = (r.get("snippet") or "")[:300]
            lines.append(f"- {r.get('title')} ({r.get('link')})\n  {snippet}")
        return "\n".join(lines)
    except requests.exceptions.RequestException as e:
        return f"Error performing Serper web search: {e}"


