#!/usr/bin/env python3
import argparse
import json
import os
import re
import subprocess
import sys
import time
from typing import Dict, List, Tuple

import requests

OTEL_AVAILABLE = False
tracer = None
meter = None
llm_token_counter = None
cmd_exec_counter = None
llm_latency_histogram = None

try:
    from opentelemetry import trace, metrics
    from opentelemetry.sdk.trace import TracerProvider
    from opentelemetry.sdk.trace.export import BatchSpanProcessor, ConsoleSpanExporter
    from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter
    from opentelemetry.sdk.metrics import MeterProvider
    from opentelemetry.sdk.metrics.export import PeriodicExportingMetricReader, ConsoleMetricExporter
    from opentelemetry.exporter.otlp.proto.http.metric_exporter import OTLPMetricExporter
    from opentelemetry.sdk.resources import Resource, SERVICE_NAME, SERVICE_VERSION
    from opentelemetry.instrumentation.requests import RequestsInstrumentor
    from opentelemetry.trace.status import Status, StatusCode

    OTEL_AVAILABLE = True
except ImportError:
    OTEL_AVAILABLE = False

API_GATEWAY = os.getenv("AGENTCTL_GATEWAY_URL", "http://localhost:30080")
VLLM_DIRECT = os.getenv("AGENTCTL_VLLM_URL", "http://localhost:30800/v1")
OTEL_ENDPOINT = os.getenv("OTEL_EXPORTER_OTLP_ENDPOINT", "http://localhost:6006")
TOKEN_FILE = os.path.expanduser("~/.agentic_token")

CYAN = '\033[96m'
GREEN = '\033[92m'
YELLOW = '\033[93m'
RED = '\033[91m'
MAGENTA = '\033[95m'
RESET = '\033[0m'
BOLD = '\033[1m'

SYSTEM_PROMPT_TEMPLATE = """You are AgentCTL, an enterprise AI coding agent running locally in the terminal.
You have direct access to inspect, refactor, edit, and manage code in the user's workspace.

CURRENT WORKSPACE:
Path: {cwd}

DIRECTORY STRUCTURE & GIT CONTEXT:
{folder_context}

OPERATIONAL RULES:
1. When asked to inspect, write, or refactor code, operate directly on files relative to the current path.
2. To write or edit files, output clean heredocs in a single bash block.
3. Provide EXACTLY ONE ```bash block per turn when proposing terminal actions or file changes.
4. NEVER simulate or hallucinate stdout/stderr inside markdown.
5. Once a refactor or file edit is applied, summarize the changes and end your turn without further ```bash blocks.
"""

def init_telemetry():
    global tracer, meter, llm_token_counter, cmd_exec_counter, llm_latency_histogram
    if not OTEL_AVAILABLE:
        return

    resource = Resource.create({
        SERVICE_NAME: "agentctl-cli",
        SERVICE_VERSION: "2.0.0",
        "deployment.environment": os.getenv("ENVIRONMENT", "local-cli")
    })

    tracer_provider = TracerProvider(resource=resource)
    if OTEL_ENDPOINT:
        span_url = f"{OTEL_ENDPOINT.rstrip('/')}/v1/traces"
        span_exporter = OTLPSpanExporter(endpoint=span_url)
        tracer_provider.add_span_processor(BatchSpanProcessor(span_exporter))
    
    trace.set_tracer_provider(tracer_provider)
    tracer = trace.get_tracer("agentctl", "2.0.0")

    if OTEL_ENDPOINT:
        metric_url = f"{OTEL_ENDPOINT.rstrip('/')}/v1/metrics"
        metric_exporter = OTLPMetricExporter(endpoint=metric_url)
        reader = PeriodicExportingMetricReader(metric_exporter, export_interval_millis=10000)
        meter_provider = MeterProvider(resource=resource, metric_readers=[reader])
        metrics.set_meter_provider(meter_provider)

    meter = metrics.get_meter("agentctl", "2.0.0")

    llm_token_counter = meter.create_counter("agentctl.llm.tokens.total", description="Total tokens generated")
    cmd_exec_counter = meter.create_counter("agentctl.commands.executed.total", description="Total bash commands")
    llm_latency_histogram = meter.create_histogram("agentctl.llm.latency.seconds", description="LLM response latency")

    RequestsInstrumentor().instrument()

init_telemetry()

def get_token() -> str:
    if not os.path.exists(TOKEN_FILE):
        print(f"{RED}Error: Unauthenticated. Run 'agentctl login <token>' first.{RESET}")
        sys.exit(1)
    with open(TOKEN_FILE, "r") as f:
        return f.read().strip()

def inspect_workspace() -> Tuple[str, str]:
    if tracer:
        with tracer.start_as_current_span("inspect_workspace") as span:
            return _do_inspect_workspace(span)
    return _do_inspect_workspace(None)

def _do_inspect_workspace(span) -> Tuple[str, str]:
    cwd = os.getcwd()
    ignored = {'.git', '__pycache__', 'node_modules', '.venv', 'venv', '.idea', '.vscode', 'dist', 'build'}
    file_list = []

    for root, dirs, files in os.walk(cwd):
        dirs[:] = [d for d in dirs if d not in ignored]
        rel_root = os.path.relpath(root, cwd)
        prefix = "" if rel_root == "." else rel_root + "/"
        for f in files:
            if len(file_list) < 40: file_list.append(prefix + f)
            else: break
        if len(file_list) >= 40:
            file_list.append("... (additional files truncated)")
            break

    context_str = "\n".join(f"- {f}" for f in file_list) if file_list else "Directory is empty."
    try:
        git_res = subprocess.run("git status --short -b", shell=True, text=True, capture_output=True, cwd=cwd)
        if git_res.returncode == 0 and git_res.stdout.strip():
            context_str += f"\n\nGit Status:\n{git_res.stdout.strip()}"
    except Exception as e:
        if span: span.record_exception(e)

    if span:
        span.set_attribute("workspace.path", cwd)
        span.set_attribute("workspace.file_count", len(file_list))
    return cwd, context_str


def chat_repl():
    if tracer:
        with tracer.start_as_current_span("interactive_session") as session_span:
            _run_chat_repl(session_span)
    else:
        _run_chat_repl(None)

def _run_chat_repl(session_span):
    cwd, folder_context = inspect_workspace()
    system_prompt = SYSTEM_PROMPT_TEMPLATE.format(cwd=cwd, folder_context=folder_context)

    print(f"{CYAN}{BOLD}╭────────────╮{RESET}")
    print(f"{CYAN}{BOLD}│  AgentCTL  │{RESET}")
    print(f"{CYAN}{BOLD}╰────────────╯{RESET}")
    print(f"{MAGENTA}📂 Directory:{RESET} {BOLD}{cwd}{RESET}")
    print(f"{MAGENTA}🔌 Target vLLM:{RESET} {VLLM_DIRECT}")
    if OTEL_AVAILABLE:
        print(f"{CYAN}📡 Telemetry (OTel):{RESET} Active ({OTEL_ENDPOINT})")
    print(f"{YELLOW}Type '/exit' to quit, '/clear' to reset, '/refresh' to re-scan files.{RESET}\n")

    messages = [{"role": "system", "content": system_prompt}]

    while True:
        try:
            user_input = input(f"{GREEN}{BOLD}❯ You:{RESET} ")
            if not user_input.strip(): continue
            if user_input.lower() in ['/exit', 'exit', 'quit']: break
            if user_input.lower() in ['/clear', 'clear']:
                cwd, folder_context = inspect_workspace()
                system_prompt = SYSTEM_PROMPT_TEMPLATE.format(cwd=cwd, folder_context=folder_context)
                messages = [{"role": "system", "content": system_prompt}]
                print(f"{YELLOW}Context reset to initial folder state.{RESET}\n")
                continue
            if user_input.lower() in ['/refresh', 'refresh']:
                cwd, folder_context = inspect_workspace()
                messages[0] = {"role": "system", "content": SYSTEM_PROMPT_TEMPLATE.format(cwd=cwd, folder_context=folder_context)}
                print(f"{YELLOW}Workspace context refreshed.{RESET}\n")
                continue

            messages.append({"role": "user", "content": user_input})
            process_llm_turn(messages, cwd)
        except (KeyboardInterrupt, EOFError):
            print(f"\n{YELLOW}Session ended.{RESET}")
            break

def process_llm_turn(messages: List[Dict[str, str]], cwd: str):
    if tracer:
        with tracer.start_as_current_span("process_llm_turn") as span:
            _do_process_llm_turn(messages, cwd, span)
    else:
        _do_process_llm_turn(messages, cwd, None)

def _do_process_llm_turn(messages: List[Dict[str, str]], cwd: str, span):
    start_time = time.time()
    while True:
        print(f"\n{MAGENTA}{BOLD}AgentCTL:{RESET} ", end="", flush=True)
        payload = {"model": "qwen", "messages": messages, "stream": True, "max_tokens": 4096, "temperature": 0.1}
        turn_span = tracer.start_span("vllm_stream_request") if tracer else None

        try:
            response = requests.post(f"{VLLM_DIRECT}/chat/completions", json=payload, stream=True, timeout=10)
            response.raise_for_status()
        except requests.exceptions.RequestException as e:
            print(f"{RED}\nConnection Error: Unable to reach vLLM at {VLLM_DIRECT}{RESET}")
            print(f"{RED}Ensure your server is running or configure AGENTCTL_VLLM_URL.{RESET}")
            if turn_span:
                turn_span.set_status(Status(StatusCode.ERROR, str(e)))
                turn_span.end()
            return

        full_response = ""
        token_count = 0

        for line in response.iter_lines():
            if line:
                decoded = line.decode('utf-8')
                if decoded.startswith("data: ") and decoded != "data: [DONE]":
                    try:
                        chunk = json.loads(decoded[6:])
                        content = chunk['choices'][0]['delta'].get('content', '')
                        full_response += content
                        token_count += 1
                        sys.stdout.write(content)
                        sys.stdout.flush()
                    except json.JSONDecodeError:
                        pass
        print()
        messages.append({"role": "assistant", "content": full_response})

        duration = time.time() - start_time
        if llm_token_counter: llm_token_counter.add(token_count, {"model": "qwen"})
        if llm_latency_histogram: llm_latency_histogram.record(duration, {"model": "qwen"})
        if turn_span:
            turn_span.set_attribute("llm.tokens_received", token_count)
            turn_span.set_attribute("llm.duration_seconds", duration)
            turn_span.end()

        bash_blocks = re.findall(r'```bash\n(.*?)\n```', full_response, re.DOTALL)
        if not bash_blocks: break

        script = bash_blocks[0].strip()
        if not script: break

        print(f"\n{YELLOW}⚙️  Action Proposed:{RESET}\n{CYAN}{script}{RESET}")
        confirm = input(f"{YELLOW}Execute in {cwd}? [Y/n]: {RESET}").strip().lower()

        if confirm in ['', 'y', 'yes']: execute_command(script, cwd, messages)
        else:
            print(f"{YELLOW}Action cancelled.{RESET}\n")
            messages.append({"role": "user", "content": "Action cancelled. Do not propose further commands."})
            break

def execute_command(script: str, cwd: str, messages: List[Dict[str, str]]):
    cmd_span = tracer.start_span("execute_bash_command") if tracer else None
    if cmd_span:
        cmd_span.set_attribute("cmd.script", script)
        cmd_span.set_attribute("cmd.cwd", cwd)
    if cmd_exec_counter: cmd_exec_counter.add(1)

    result = subprocess.run(script, shell=True, text=True, capture_output=True, cwd=cwd)
    output_str = f"STDOUT:\n{result.stdout}\n" if result.stdout else ""
    output_str += f"STDERR:\n{result.stderr}\n" if result.stderr else ""
    if not output_str: output_str = "Executed successfully with no stdout/stderr."

    if cmd_span:
        cmd_span.set_attribute("cmd.exit_code", result.returncode)
        if result.returncode != 0: cmd_span.set_status(Status(StatusCode.ERROR, f"Exit Code {result.returncode}"))
        cmd_span.end()

    print(f"{CYAN}--- Output ---{RESET}\n{output_str.strip()}\n{CYAN}--------------{RESET}\n")
    messages.append({"role": "user", "content": f"Command output:\n{output_str}\nIf finished, summarize and stop."})

def login(api_key: str):
    with open(TOKEN_FILE, "w") as f: f.write(api_key)
    print(f"{GREEN}Authenticated successfully.{RESET}")

def submit_background(prompt: str, watch: bool):
    token = get_token()
    try:
        res = requests.post(f"{API_GATEWAY}/tasks", params={"prompt": prompt}, headers={"X-API-Key": token})
        res.raise_for_status()
        task_id = res.json()["task_id"]
        print(f"{GREEN}Task queued in background. Task ID: {task_id}{RESET}")

        if watch:
            print(f"{YELLOW}Streaming status...{RESET}\n")
            while True:
                status_res = requests.get(f"{API_GATEWAY}/tasks/{task_id}", headers={"X-API-Key": token})
                data = status_res.json()
                sys.stdout.write(f"\rStatus: [{data['status'].upper()}]")
                sys.stdout.flush()
                if data['status'] == 'completed':
                    print(f"\n\n{CYAN}--- Output ---{RESET}\n{data['result']}")
                    break
                elif data['status'] == 'failed':
                    print(f"\n\n{RED}--- Error ---{RESET}\n{data.get('error', 'Unknown error')}")
                    break
                time.sleep(2)
    except requests.exceptions.RequestException as e:
        print(f"{RED}Connection Error: Failed to reach API Gateway at {API_GATEWAY}{RESET}")

def list_tasks():
    try:
        res = requests.get(f"{API_GATEWAY}/tasks", headers={"X-API-Key": get_token()})
        res.raise_for_status()
        print(f"{CYAN}{'TASK ID':<40} | {'STATUS'}{RESET}\n" + "-" * 60)
        for t in res.json(): print(f"{t['id']:<40} | {t['status'].upper()}")
    except requests.exceptions.RequestException as e:
        print(f"{RED}Connection Error: Failed to reach API Gateway at {API_GATEWAY}{RESET}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="AgentCTL CLI with Telemetry")
    subparsers = parser.add_subparsers(dest="command")

    p_login = subparsers.add_parser("login", help="Authenticate with token")
    p_login.add_argument("token", help="API token")

    p_submit = subparsers.add_parser("submit", help="Submit background task")
    p_submit.add_argument("prompt", help="Task prompt")
    p_submit.add_argument("-w", "--watch", action="store_true", help="Watch until complete")

    p_list = subparsers.add_parser("list", help="List submitted tasks")

    args = parser.parse_args()

    if args.command is None: chat_repl()
    elif args.command == "login": login(args.token)
    elif args.command == "submit": submit_background(args.prompt, args.watch)
    elif args.command == "list": list_tasks()
