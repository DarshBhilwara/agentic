    p_login.add_argument("token", help="API token")

    p_submit = subparsers.add_parser("submit", help="Submit background task")
    p_submit.add_argument("prompt", help="Task prompt")
    p_submit.add_argument("-w", "--watch", action="store_true", help="Watch until complete")

    p_list = subparsers.add_parser("list", help="List submitted tasks")

    args = parser.parse_args()

    if args.command is None: chat_repl()
    elif args.command == "login": login(args.token)
    elif args.command == "submit": submit_background(args.prompt, args.watch)
    elif args.command == "list": list_tasks()
