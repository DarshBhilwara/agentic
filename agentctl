#!/usr/bin/env python3
"""Authenticated access client for the agent node."""

import argparse
import os
import sys
import time

import requests


API_GATEWAY = os.getenv("AGENTCTL_GATEWAY_URL", "http://localhost:30080")
TOKEN_FILE = os.path.expanduser("~/.agentic_token")


def get_token():
    try:
        with open(TOKEN_FILE) as file:
            token = file.read().strip()
    except OSError:
        token = ""
    if not token:
        raise SystemExit("Unauthenticated. Run 'agentctl login <token>' first.")
    return token


def headers():
    return {"X-API-Key": get_token()}


def login(token):
    with open(TOKEN_FILE, "w") as file:
        file.write(token)
    os.chmod(TOKEN_FILE, 0o600)
    print("Authenticated successfully.")


def submit(prompt, watch):
    try:
        response = requests.post(f"{API_GATEWAY}/tasks", params={"prompt": prompt}, headers=headers(), timeout=15)
        response.raise_for_status()
        task_id = response.json()["task_id"]
        print(f"Task queued. Task ID: {task_id}")
        if watch:
            while True:
                status = requests.get(f"{API_GATEWAY}/tasks/{task_id}", headers=headers(), timeout=15).json()
                if status["status"] == "completed":
                    print(f"\n--- Output ---\n{status.get('result', '')}")
                    return
                if status["status"] == "failed":
                    raise RuntimeError(status.get("error", "Unknown agent error"))
                print(f"\rStatus: {status['status'].upper()}", end="", flush=True)
                time.sleep(2)
    except (requests.RequestException, RuntimeError) as exc:
        print(f"Connection or agent error: {exc}", file=sys.stderr)


def list_tasks():
    try:
        response = requests.get(f"{API_GATEWAY}/tasks", headers=headers(), timeout=15)
        response.raise_for_status()
        print(f"{'TASK ID':<40} | STATUS\n{'-' * 60}")
        for task in response.json():
            print(f"{task['id']:<40} | {task['status'].upper()}")
    except requests.RequestException as exc:
        print(f"Connection error: {exc}", file=sys.stderr)


parser = argparse.ArgumentParser(description="Authenticated access to the agent node")
commands = parser.add_subparsers(dest="command")
login_parser = commands.add_parser("login", help="Store an enterprise access token")
login_parser.add_argument("token")
submit_parser = commands.add_parser("submit", help="Submit a task to the agent node")
submit_parser.add_argument("prompt")
submit_parser.add_argument("-w", "--watch", action="store_true")
commands.add_parser("list", help="List your tasks")
args = parser.parse_args()

if args.command == "login":
    login(args.token)
elif args.command == "submit":
    submit(args.prompt, args.watch)
elif args.command == "list":
    list_tasks()
else:
    parser.print_help()
