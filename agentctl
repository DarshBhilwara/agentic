        with tracer.start_as_current_span("interactive_session") as session_span:
            _run_chat_repl(session_span)
    else:
        _run_chat_repl(None)

def _run_chat_repl(session_span):
    cwd, folder_context = inspect_workspace()
    system_prompt = SYSTEM_PROMPT_TEMPLATE.format(cwd=cwd, folder_context=folder_context)

    print(f"{CYAN}{BOLD}╭────────────╮{RESET}")
    print(f"{CYAN}{BOLD}│  AgentCTL  │{RESET}")
    print(f"{CYAN}{BOLD}╰────────────╯{RESET}")
    print(f"{MAGENTA}📂 Directory:{RESET} {BOLD}{cwd}{RESET}")
    print(f"{MAGENTA}🔌 Target vLLM:{RESET} {VLLM_DIRECT} ({MODEL_NAME})")
    print(f"{MAGENTA}🔧 Tools:{RESET} " + ", ".join(TOOL_IMPLEMENTATIONS.keys()))
    if not os.getenv("SERPER_API_KEY"):
        print(f"{YELLOW}   (web_search disabled — set SERPER_API_KEY to enable Serper search){RESET}")
    
    if OTEL_AVAILABLE:
        t_url = OTEL_TRACES_ENDPOINT or "Disabled"
        m_url = OTEL_METRICS_ENDPOINT or "Disabled"
        print(f"{CYAN}📡 Telemetry (OTel):{RESET} Active")
        print(f"{CYAN}   ├─ Traces: {RESET} {t_url}")
        print(f"{CYAN}   └─ Metrics:{RESET} {m_url}")

    print(f"{YELLOW}Type '/exit' to quit, '/clear' to reset, '/refresh' to re-scan files.{RESET}\n")

    messages = [{"role": "system", "content": system_prompt}]

    while True:
        try:
            user_input = input(f"{GREEN}{BOLD}❯ You:{RESET} ")
            if not user_input.strip(): continue
            if user_input.lower() in ['/exit', 'exit', 'quit']: break
            if user_input.lower() in ['/clear', 'clear']:
                cwd, folder_context = inspect_workspace()
                system_prompt = SYSTEM_PROMPT_TEMPLATE.format(cwd=cwd, folder_context=folder_context)
                messages = [{"role": "system", "content": system_prompt}]
                print(f"{YELLOW}Context reset to initial folder state.{RESET}\n")
                continue
            if user_input.lower() in ['/refresh', 'refresh']:
                cwd, folder_context = inspect_workspace()
                messages[0] = {"role": "system", "content": SYSTEM_PROMPT_TEMPLATE.format(cwd=cwd, folder_context=folder_context)}
                print(f"{YELLOW}Workspace context refreshed.{RESET}\n")
                continue

            messages.append({"role": "user", "content": user_input})
            process_llm_turn(messages, cwd)
        except (KeyboardInterrupt, EOFError):
            print(f"\n{YELLOW}Session ended.{RESET}")
            break

def process_llm_turn(messages: List[Dict], cwd: str):
    if tracer:
        with tracer.start_as_current_span("process_llm_turn") as span:
            _do_process_llm_turn(messages, cwd, span)
    else:
        _do_process_llm_turn(messages, cwd, None)

def _do_process_llm_turn(messages: List[Dict], cwd: str, span):
    while True:
        print(f"\n{MAGENTA}{BOLD}AgentCTL:{RESET} ", end="", flush=True)
        payload = {
            "model": MODEL_NAME,
            "messages": messages,
            "stream": True,
            "stream_options": {
                "include_usage": True
            },
            "max_tokens": 4096,
            "temperature": 0.1,
            "tools": TOOLS_SCHEMA,
            "tool_choice": "auto",
        }
        turn_span = tracer.start_span("vllm_stream_request") if tracer else None
        start_time = time.time()

        try:
            response = requests.post(
                f"{VLLM_DIRECT}/chat/completions",
                json=payload,
                stream=True,
                timeout=(10, 300),
            )

            if not response.ok:
                error_body = response.text[:4000]
                print(
                    f"{RED}\nvLLM returned HTTP {response.status_code}:{RESET}\n"
                    f"{error_body}\n"
                )

                if turn_span:
                    turn_span.set_status(
                        Status(
                            StatusCode.ERROR,
                            f"HTTP {response.status_code}: {error_body[:500]}"
                        )
                    )
                    turn_span.end()

                return

        except requests.exceptions.Timeout as e:
            print(
                f"{RED}\nvLLM request timed out after 300 seconds.{RESET}\n"
                f"Endpoint: {VLLM_DIRECT}\n"
                f"Error: {e}\n"
            )

            if turn_span:
                turn_span.set_status(
                    Status(StatusCode.ERROR, f"Timeout: {e}")
                )
                turn_span.end()

            return

        except requests.exceptions.ConnectionError as e:
            print(
                f"{RED}\nCannot connect to vLLM.{RESET}\n"
                f"Endpoint: {VLLM_DIRECT}\n"
                f"Error: {e}\n"
            )

            if turn_span:
                turn_span.set_status(
                    Status(StatusCode.ERROR, f"Connection error: {e}")
                )
                turn_span.end()

            return

        except requests.exceptions.RequestException as e:
            print(
                f"{RED}\nvLLM request failed.{RESET}\n"
                f"Endpoint: {VLLM_DIRECT}\n"
                f"Error: {e}\n"
            )

            if turn_span:
                turn_span.set_status(
                    Status(StatusCode.ERROR, str(e))
                )
                turn_span.end()

            return

        full_response = ""
        tool_calls_accum: Dict[int, Dict[str, str]] = {}
        usage = {}

        for line in response.iter_lines():
            if not line:
                continue

            decoded = line.decode("utf-8")

            if not decoded.startswith("data: "):
                continue

            data = decoded[6:]

            if data == "[DONE]":
                continue

            try:
                chunk = json.loads(data)
            except json.JSONDecodeError:
                continue

            if chunk.get("usage"):
                usage = chunk["usage"]

            choice = chunk.get("choices", [{}])[0] if chunk.get("choices") else {}
            delta = choice.get("delta", {})

            content = delta.get("content")

            if content:
                full_response += content
                sys.stdout.write(content)
                sys.stdout.flush()

            for tc_delta in (delta.get("tool_calls") or []):
                idx = tc_delta.get("index", 0)

                slot = tool_calls_accum.setdefault(
                    idx,
                    {
                        "id": "",
                        "name": "",
                        "arguments": ""
                    }
                )

                if tc_delta.get("id"):
                    slot["id"] = tc_delta["id"]

                fn_delta = tc_delta.get("function") or {}

                if fn_delta.get("name"):
                    slot["name"] += fn_delta["name"]

                if fn_delta.get("arguments"):
                    slot["arguments"] += fn_delta["arguments"]
        print()

        duration = time.time() - start_time
        
        total_tokens = usage.get("total_tokens", 0)
        prompt_tokens = usage.get("prompt_tokens", 0)
        completion_tokens = usage.get("completion_tokens", 0)

        if llm_token_counter:
            llm_token_counter.add(
                total_tokens,
                {
                    "model": MODEL_NAME,
                    "token.type": "total",
                },
            )

        if llm_latency_histogram: 
            llm_latency_histogram.record(duration, {"model": MODEL_NAME})
            
        if turn_span:
            turn_span.set_attribute("llm.duration_seconds", duration)
            turn_span.set_attribute("llm.tool_calls_requested", len(tool_calls_accum))
            turn_span.set_attribute(
                "llm.tokens.prompt",
                prompt_tokens,
            )
            turn_span.set_attribute(
                "llm.tokens.completion",
                completion_tokens,
            )
            turn_span.set_attribute(
                "llm.tokens.total",
                total_tokens,
            )
            turn_span.end()

        if not tool_calls_accum:
            messages.append({"role": "assistant", "content": full_response})
            break

        tool_calls_list = []
        for i in sorted(tool_calls_accum.keys()):
            slot = tool_calls_accum[i]
            tool_calls_list.append({
                "id": slot["id"] or f"call_{i}",
                "type": "function",
                "function": {"name": slot["name"], "arguments": slot["arguments"] or "{}"},
            })

        messages.append({
            "role": "assistant",
            "content": full_response or None,
            "tool_calls": tool_calls_list,
        })

        for tc in tool_calls_list:
            name = tc["function"]["name"]
            try:
                args = json.loads(tc["function"]["arguments"])
            except json.JSONDecodeError:
                args = {}
            result, cancelled = dispatch_tool_call(name, args, cwd)
            messages.append({
                "role": "tool",
                "tool_call_id": tc["id"],
                "name": name,
                "content": result,
            })
            if cancelled:
                messages.append({
                    "role": "user",
                    "content": "Action was declined. Do not retry it; adjust your plan or ask how to proceed.",
                })

def dispatch_tool_call(name: str, args: Dict, cwd: str) -> Tuple[str, bool]:
    impl = TOOL_IMPLEMENTATIONS.get(name)
    if impl is None:
        return f"Error: unknown tool '{name}'.", False

    if name in CONFIRM_REQUIRED_TOOLS:
        print(f"\n{YELLOW}⚙️  Tool call proposed:{RESET} {BOLD}{name}{RESET}")
        print(f"{CYAN}{json.dumps(args, indent=2)}{RESET}")
        confirm = input(f"{YELLOW}Allow action in {cwd}? [Y/n]: {RESET}").strip().lower()
        if confirm not in ['', 'y', 'yes']:
            print(f"{YELLOW}Action cancelled.{RESET}\n")
            return "User declined to run this action.", True
    else:
        print(f"\n{YELLOW}🔧 Calling tool:{RESET} {name}({json.dumps(args)})")

    if tracer:
        with tracer.start_as_current_span(f"tool.{name}") as sp:
            sp.set_attribute("tool.name", name)
            sp.set_attribute("tool.args", json.dumps(args)[:500])
            result = impl(args, cwd)
            sp.set_attribute("tool.result_length", len(result))
    else:
        result = impl(args, cwd)

    if name == "execute_command" and cmd_exec_counter: cmd_exec_counter.add(1)
    if tool_call_counter: tool_call_counter.add(1, {"tool": name})

    print(f"{CYAN}--- Result ({name}) ---{RESET}\n{result.strip()[:2000]}\n{CYAN}--------------{RESET}\n")
    return result, False

def login(api_key: str):
    with open(TOKEN_FILE, "w") as f: f.write(api_key)
    print(f"{GREEN}Authenticated successfully.{RESET}")

def submit_background(prompt: str, watch: bool):
    token = get_token()
    try:
        res = requests.post(f"{API_GATEWAY}/tasks", params={"prompt": prompt}, headers={"X-API-Key": token})
        res.raise_for_status()
        task_id = res.json()["task_id"]
        print(f"{GREEN}Task queued in background. Task ID: {task_id}{RESET}")

        if watch:
            print(f"{YELLOW}Streaming status...{RESET}\n")
            while True:
                status_res = requests.get(f"{API_GATEWAY}/tasks/{task_id}", headers={"X-API-Key": token})
                data = status_res.json()
                sys.stdout.write(f"\rStatus: [{data['status'].upper()}]")
                sys.stdout.flush()
                if data['status'] == 'completed':
                    print(f"\n\n{CYAN}--- Output ---{RESET}\n{data['result']}")
                    break
                elif data['status'] == 'failed':
                    print(f"\n\n{RED}--- Error ---{RESET}\n{data.get('error', 'Unknown error')}")
                    break
                time.sleep(2)
    except requests.exceptions.RequestException as e:
        print(f"{RED}Connection Error: Failed to reach API Gateway at {API_GATEWAY}{RESET}")

def list_tasks():
    try:
        res = requests.get(f"{API_GATEWAY}/tasks", headers={"X-API-Key": get_token()})
        res.raise_for_status()
        print(f"{CYAN}{'TASK ID':<40} | {'STATUS'}{RESET}\n" + "-" * 60)
        for t in res.json(): print(f"{t['id']:<40} | {t['status'].upper()}")
    except requests.exceptions.RequestException as e:
        print(f"{RED}Connection Error: Failed to reach API Gateway at {API_GATEWAY}{RESET}")

