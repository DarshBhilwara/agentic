def init_telemetry():
    global tracer, meter, llm_token_counter, cmd_exec_counter, tool_call_counter, llm_latency_histogram
    if not OTEL_AVAILABLE:
        return

    resource = Resource.create({
        SERVICE_NAME: "agentctl-cli",
        SERVICE_VERSION: "0.1", "deployment.environment": os.getenv("ENVIRONMENT", "local-cli")
    })

    tracer_provider = TracerProvider(resource=resource)
    
    trace_url = OTEL_TRACES_ENDPOINT
    if trace_url:
        span_exporter = OTLPSpanExporter(endpoint=trace_url)
        tracer_provider.add_span_processor(BatchSpanProcessor(span_exporter))

    trace.set_tracer_provider(tracer_provider)
    tracer = trace.get_tracer("agentctl", "0.1")

    metric_url = OTEL_METRICS_ENDPOINT
    if metric_url:
        metric_exporter = OTLPMetricExporter(endpoint=metric_url)
        reader = PeriodicExportingMetricReader(metric_exporter, export_interval_millis=10000)
        meter_provider = MeterProvider(resource=resource, metric_readers=[reader])
        metrics.set_meter_provider(meter_provider)

    meter = metrics.get_meter("agentctl", "0.1")

    llm_token_counter = meter.create_counter("agentctl.llm.tokens.total", description="Total tokens generated")
    cmd_exec_counter = meter.create_counter("agentctl.commands.executed.total", description="Total shell commands executed")
    tool_call_counter = meter.create_counter("agentctl.tools.invoked.total", description="Total tool calls invoked")
    llm_latency_histogram = meter.create_histogram("agentctl.llm.latency.seconds", description="LLM response latency")

    RequestsInstrumentor().instrument()

init_telemetry()

def get_token() -> str:
    if not os.path.exists(TOKEN_FILE):
        print(f"{RED}Error: Unauthenticated. Run 'agentctl login <token>' first.{RESET}")
        sys.exit(1)
    with open(TOKEN_FILE, "r") as f:
        return f.read().strip()

def inspect_workspace() -> Tuple[str, str]:
    if tracer:
        with tracer.start_as_current_span("inspect_workspace") as span:
            return _do_inspect_workspace(span)
    return _do_inspect_workspace(None)

def _do_inspect_workspace(span) -> Tuple[str, str]:
    cwd = os.getcwd()
    ignored = {'.git', '__pycache__', 'node_modules', '.venv', 'venv', '.idea', '.vscode', 'dist', 'build'}
    file_list = []

    for root, dirs, files in os.walk(cwd):
        dirs[:] = [d for d in dirs if d not in ignored]
        rel_root = os.path.relpath(root, cwd)
        prefix = "" if rel_root == "." else rel_root + "/"
        for f in files:
            if len(file_list) < 40: file_list.append(prefix + f)
            else: break
        if len(file_list) >= 40:
            file_list.append("... (additional files truncated)")
            break

    context_str = "\n".join(f"- {f}" for f in file_list) if file_list else "Directory is empty."
    try:
        git_res = subprocess.run("git status --short -b", shell=True, text=True, capture_output=True, cwd=cwd)
        if git_res.returncode == 0 and git_res.stdout.strip():
            context_str += f"\n\nGit Status:\n{git_res.stdout.strip()}"
    except Exception as e:
        if span: span.record_exception(e)

    if span:
        span.set_attribute("workspace.path", cwd)
        span.set_attribute("workspace.file_count", len(file_list))
    return cwd, context_str


def chat_repl():
