#!/usr/bin/env python3
import argparse, requests, time, os, sys, json, subprocess, re

API_GATEWAY = "http://localhost:30080"
VLLM_DIRECT = "http://localhost:30800/v1"
TOKEN_FILE = os.path.expanduser("~/.agentic_token")

# ANSI Color Constants
CYAN = '\033[96m'
GREEN = '\033[92m'
YELLOW = '\033[93m'
RED = '\033[91m'
MAGENTA = '\033[95m'
RESET = '\033[0m'
BOLD = '\033[1m'

SYSTEM_PROMPT_TEMPLATE = """You are AgentCTL, an enterprise AI coding agent running locally in the terminal.
You have direct access to inspect, refactor, edit, and manage code in the user's workspace.

CURRENT WORKSPACE:
Path: {cwd}

DIRECTORY STRUCTURE & GIT CONTEXT:
{folder_context}

OPERATIONAL RULES:
1. When asked to inspect, write, or refactor code, operate directly on files relative to the current path.
2. To write or edit files, output clean heredocs in a single bash block:
cat << 'EOF' > filename.ext
# updated code
EOF
3. Provide EXACTLY ONE ```bash block per turn when proposing terminal actions or file changes.
4. NEVER simulate or hallucinate stdout/stderr inside markdown.
5. Once a refactor or file edit is applied, summarize the changes and end your turn without further ```bash blocks.
"""

def get_token():
    if not os.path.exists(TOKEN_FILE):
        print(f"{RED}Error: Unauthenticated. Run 'agentctl login <token>' first.{RESET}")
        sys.exit(1)
    with open(TOKEN_FILE, "r") as f:
        return f.read().strip()

def inspect_workspace():
    """Gathers directory files and git status from current working directory."""
    cwd = os.getcwd()
    ignored = {'.git', '__pycache__', 'node_modules', '.venv', 'venv', '.idea', '.vscode', 'dist', 'build'}
    file_list = []

    for root, dirs, files in os.walk(cwd):
        dirs[:] = [d for d in dirs if d not in ignored]
        rel_root = os.path.relpath(root, cwd)
        prefix = "" if rel_root == "." else rel_root + "/"
        for f in files:
            if len(file_list) < 40:
                file_list.append(prefix + f)
            else:
                break
        if len(file_list) >= 40:
            file_list.append("... (additional files truncated)")
            break

    context_str = "\n".join(f"- {f}" for f in file_list) if file_list else "Directory is empty."

    # Git branch / status check
    try:
        git_res = subprocess.run("git status --short -b", shell=True, text=True, capture_output=True, cwd=cwd)
        if git_res.returncode == 0 and git_res.stdout.strip():
            context_str += f"\n\nGit Status:\n{git_res.stdout.strip()}"
    except Exception:
        pass

    return cwd, context_str

def chat_repl():
    cwd, folder_context = inspect_workspace()
    system_prompt = SYSTEM_PROMPT_TEMPLATE.format(cwd=cwd, folder_context=folder_context)

    print(f"{CYAN}{BOLD}╭──────────────────────────────────────────────────────────╮{RESET}")
    print(f"{CYAN}{BOLD}│  AgentCTL Workspace Assistant (Claude-Code Style)        │{RESET}")
    print(f"{CYAN}{BOLD}╰──────────────────────────────────────────────────────────╯{RESET}")
    print(f"{MAGENTA}📂 Active Directory:{RESET} {BOLD}{cwd}{RESET}")
    print(f"{YELLOW}Type '/exit' to quit, '/clear' to reset, '/refresh' to re-scan files.{RESET}\n")

    messages = [{"role": "system", "content": system_prompt}]

    while True:
        try:
            user_input = input(f"{GREEN}{BOLD}❯ You:{RESET} ")
            if not user_input.strip(): continue
            if user_input.lower() in ['/exit', 'exit', 'quit']: break
            
            if user_input.lower() in ['/clear', 'clear']:
                cwd, folder_context = inspect_workspace()
                system_prompt = SYSTEM_PROMPT_TEMPLATE.format(cwd=cwd, folder_context=folder_context)
                messages = [{"role": "system", "content": system_prompt}]
                print(f"{YELLOW}Context reset to initial folder state.{RESET}\n")
                continue

            if user_input.lower() in ['/refresh', 'refresh']:
                cwd, folder_context = inspect_workspace()
                system_prompt = SYSTEM_PROMPT_TEMPLATE.format(cwd=cwd, folder_context=folder_context)
                messages[0] = {"role": "system", "content": system_prompt}
                print(f"{YELLOW}Workspace context refreshed.{RESET}\n")
                continue

            messages.append({"role": "user", "content": user_input})
            process_llm_turn(messages, cwd)

        except (KeyboardInterrupt, EOFError):
            print(f"\n{YELLOW}Session ended.{RESET}")
            break

def process_llm_turn(messages, cwd):
    while True:
        print(f"\n{MAGENTA}{BOLD}AgentCTL:{RESET} ", end="", flush=True)
        payload = {
            "model": "qwen",
            "messages": messages,
            "stream": True,
            "max_tokens": 4096,
            "temperature": 0.1
        }

        try:
            response = requests.post(f"{VLLM_DIRECT}/chat/completions", json=payload, stream=True)
        except requests.exceptions.ConnectionError:
            print(f"{RED}\nError: vLLM service unavailable at {VLLM_DIRECT}. Check container status.{RESET}")
            return

        full_response = ""
        for line in response.iter_lines():
            if line:
                decoded = line.decode('utf-8')
                if decoded.startswith("data: ") and decoded != "data: [DONE]":
                    try:
                        chunk = json.loads(decoded[6:])
                        content = chunk['choices'][0]['delta'].get('content', '')
                        full_response += content
                        sys.stdout.write(content)
                        sys.stdout.flush()
                    except json.JSONDecodeError:
                        pass
        
        print()
        messages.append({"role": "assistant", "content": full_response})

        bash_blocks = re.findall(r'```bash\n(.*?)\n```', full_response, re.DOTALL)
        if not bash_blocks:
            break

        script = bash_blocks[0].strip()
        if not script:
            break
            
        print(f"\n{YELLOW}⚙️  Action Proposed:{RESET}")
        print(f"{CYAN}{script}{RESET}")
        confirm = input(f"{YELLOW}Execute in {cwd}? [Y/n]: {RESET}").strip().lower()
        
        if confirm in ['', 'y', 'yes']:
            result = subprocess.run(script, shell=True, text=True, capture_output=True, cwd=cwd)
            output_str = ""
            if result.stdout: output_str += f"STDOUT:\n{result.stdout}\n"
            if result.stderr: output_str += f"STDERR:\n{result.stderr}\n"
            if not output_str: output_str = "Executed successfully with no stdout/stderr."
            
            print(f"{CYAN}--- Command Output ---{RESET}\n{output_str.strip()}\n{CYAN}----------------------{RESET}\n")
            messages.append({
                "role": "user", 
                "content": f"Command output:\n{output_str}\nIf the task is finished, summarize changes and stop proposing bash commands."
            })
        else:
            print(f"{YELLOW}Action cancelled by user.{RESET}\n")
            messages.append({"role": "user", "content": "Action cancelled by user. Do not propose further commands."})
            break

def login(api_key):
    with open(TOKEN_FILE, "w") as f: f.write(api_key)
    print(f"{GREEN}Authenticated successfully.{RESET}")

def submit_background(prompt, watch):
    token = get_token()
    res = requests.post(f"{API_GATEWAY}/tasks", params={"prompt": prompt}, headers={"X-API-Key": token})
    if res.status_code != 200:
        print(f"{RED}Server Error: {res.text}{RESET}")
        return
    
    task_id = res.json()["task_id"]
    print(f"{GREEN}Task queued in background. Task ID: {task_id}{RESET}")

    if watch:
        print(f"{YELLOW}Streaming status...{RESET}\n")
        while True:
            status_res = requests.get(f"{API_GATEWAY}/tasks/{task_id}", headers={"X-API-Key": token})
            data = status_res.json()
            sys.stdout.write(f"\rStatus: [{data['status'].upper()}]")
            sys.stdout.flush()
            
            if data['status'] == 'completed':
                print(f"\n\n{CYAN}--- Output ---{RESET}\n{data['result']}")
                break
            elif data['status'] == 'failed':
                print(f"\n\n{RED}--- Error ---{RESET}\n{data.get('error', 'Unknown error')}")
                break
            time.sleep(2)

def list_tasks():
    token = get_token()
    res = requests.get(f"{API_GATEWAY}/tasks", headers={"X-API-Key": token})
    if res.status_code != 200:
        print(f"{RED}Server Error: {res.text}{RESET}")
        return
    print(f"{CYAN}{'TASK ID':<40} | {'STATUS'}{RESET}")
    print("-" * 60)
    for t in res.json():
        print(f"{t['id']:<40} | {t['status'].upper()}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Agentic CLI")
    subparsers = parser.add_subparsers(dest="command")

    p_login = subparsers.add_parser("login", help="Authenticate with token")
    p_login.add_argument("token", help="Corporate API token")

    p_submit = subparsers.add_parser("submit", help="Submit background task")
    p_submit.add_argument("prompt", help="Task prompt or URL")
    p_submit.add_argument("-w", "--watch", action="store_true", help="Watch until complete")

    p_list = subparsers.add_parser("list", help="List submitted tasks")

    args = parser.parse_args()

    if args.command is None:
        chat_repl()
    elif args.command == "login":
        login(args.token)
    elif args.command == "submit":
        submit_background(args.prompt, args.watch)
    elif args.command == "list":
        list_tasks()