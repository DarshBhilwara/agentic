{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "vllm",
            "readinessProbe": {
              "httpGet": {"path": "/health", "port": 8000},
              "periodSeconds": 5,
              "timeoutSeconds": 3,
              "failureThreshold": 3
